        },
        "type": {
          "const": "resync_required",
          "default": "resync_required",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "conversation_id",
        "reason"
      ],
      "title": "ResyncRequired",
      "type": "object"
    },
    "Subscribed": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "head_seq": {
          "pattern": "^(0|[1-9][0-9]{0,17}|9223372036854775807|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0})$",
          "title": "Head Seq",
          "type": "string"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "type": {
          "const": "subscribed",
          "default": "subscribed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "conversation_id",
        "head_seq"
      ],
      "title": "Subscribed",
      "type": "object"
    },
    "WSError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "UNAUTHENTICATED",
            "CONVERSATION_NOT_FOUND",
            "INVALID_INPUT",
            "HTTP_ERROR",
            "DATABASE_BUSY",
            "INTERNAL_ERROR"
          ],
          "title": "Code",
          "type": "string"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "WSError",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "error": "#/$defs/WSError",
      "heads": "#/$defs/Heads",
      "message.created": "#/$defs/MessageCreated",
      "resync_required": "#/$defs/ResyncRequired",
      "subscribed": "#/$defs/Subscribed"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Subscribed"
    },
    {
      "$ref": "#/$defs/MessageCreated"
    },
    {
      "$ref": "#/$defs/Heads"
    },
    {
      "$ref": "#/$defs/ResyncRequired"
    },
    {
      "$ref": "#/$defs/WSError"
    }
  ]
}
