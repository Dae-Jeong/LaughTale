{
  "$defs": {
    "HeadItem": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "head_seq": {
          "pattern": "^(0|[1-9][0-9]{0,17}|9223372036854775807|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0})$",
          "title": "Head Seq",
          "type": "string"
        }
      },
      "required": [
        "conversation_id",
        "head_seq"
      ],
      "title": "HeadItem",
      "type": "object"
    },
    "Heads": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/HeadItem"
          },
          "title": "Items",
          "type": "array"
        },
        "type": {
          "const": "heads",
          "default": "heads",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "title": "Heads",
      "type": "object"
    },
    "MessageCreated": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/MessageData"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "message.created",
          "default": "message.created",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "message"
      ],
      "title": "MessageCreated",
      "type": "object"
    },
    "MessageData": {
      "additionalProperties": false,
      "properties": {
        "client_message_id": {
          "format": "uuid",
          "title": "Client Message Id",
          "type": "string"
        },
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "sender_id": {
          "format": "uuid",
          "title": "Sender Id",
          "type": "string"
        },
        "seq": {
          "pattern": "^([1-9][0-9]{0,17}|9223372036854775807|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0})$",
          "title": "Seq",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "conversation_id",
        "sender_id",
        "client_message_id",
        "seq",
        "text",
        "created_at"
      ],
      "title": "MessageData",
      "type": "object"
    },
    "ResyncReason": {
      "enum": [
        "queue_overflow",
        "recovery_unavailable"
      ],
      "title": "ResyncReason",
      "type": "string"
    },
    "ResyncRequired": {
