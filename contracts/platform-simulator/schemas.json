  "RunConfig": {
    "$defs": {
      "Fault": {
        "enum": [
          "none",
          "rate_limit",
          "unavailable",
          "delay_before",
          "delay_after",
          "reject"
        ],
        "title": "Fault",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "delay_seconds": {
        "default": 3,
        "maximum": 10,
        "minimum": 0,
        "title": "Delay Seconds",
        "type": "number"
      },
      "fault": {
        "$ref": "#/$defs/Fault",
        "default": "none"
      },
      "fault_attempts": {
        "default": 1,
        "maximum": 5,
        "minimum": 0,
        "title": "Fault Attempts",
        "type": "integer"
      },
      "idempotency_supported": {
        "default": true,
        "title": "Idempotency Supported",
        "type": "boolean"
      },
      "lookup_supported": {
        "default": true,
        "title": "Lookup Supported",
        "type": "boolean"
      },
      "max_attempts": {
        "default": 5000,
        "maximum": 50000,
        "minimum": 1,
        "title": "Max Attempts",
        "type": "integer"
      },
      "max_effects": {
        "default": 1000,
        "maximum": 10000,
        "minimum": 1,
        "title": "Max Effects",
        "type": "integer"
      },
      "max_events": {
        "default": 1000,
        "maximum": 10000,
        "minimum": 1,
        "title": "Max Events",
        "type": "integer"
      },
      "run_id": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "title": "Run Id",
        "type": "string"
      },
      "seed": {
        "default": 0,
        "maximum": 2147483647,
        "minimum": 0,
        "title": "Seed",
        "type": "integer"
      }
    },
    "required": [
      "run_id"
    ],
    "title": "RunConfig",
    "type": "object"
  }
}
