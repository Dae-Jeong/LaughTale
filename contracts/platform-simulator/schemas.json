    "required": [
      "run_id",
      "profile",
      "connection_id",
      "external_conversation_id",
      "external_event_id",
      "external_message_id",
      "external_sender_id",
      "occurred_at",
      "text"
    ],
    "title": "InboundEvent",
    "type": "object"
  },
  "OutboundCommand": {
    "$defs": {
      "Profile": {
        "enum": [
          "telegram",
          "line",
          "instagram",
          "facebook",
          "whatsapp",
          "wechat",
          "kakao-bizgo"
        ],
        "title": "Profile",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "connection_id": {
        "format": "uuid",
        "title": "Connection Id",
        "type": "string"
      },
      "external_conversation_id": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "title": "External Conversation Id",
        "type": "string"
      },
      "outbound_operation_id": {
        "format": "uuid",
        "title": "Outbound Operation Id",
        "type": "string"
      },
      "profile": {
        "$ref": "#/$defs/Profile"
      },
      "run_id": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "title": "Run Id",
        "type": "string"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "text": {
        "maxLength": 2000,
