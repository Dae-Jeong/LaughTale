# Step 3 부하 발생기 — 서비스와 별도 프로세스·별도 컨테이너입니다.
# 클러스터 안에서 Service를 실제 TCP로 호출하므로 Pod 분산을 관측할 수 있습니다.
FROM python:3.14-slim
WORKDIR /app
RUN pip install --no-cache-dir "httpx2>=2.12.0"
COPY src/catalog_hub /app/catalog_hub
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "-m", "catalog_hub.tools.netload"]
